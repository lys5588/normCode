{
  "$schema": "../../../infra/_agent/_models/_paradigms/paradigm_schema.json",
  "id": "c_CanvasIntegration-Hands-Say-o_Status",
  "name": "Canvas Integration: Say Message",
  "description": "Send a message to the user via Canvas Integration Tool (me.hands.say)",
  "version": "2.0.0",
  
  "category": "canvas_integration",
  "perspective": "first_person",
  "faculty": "hands",
  
  "inputs": {
    "horizontal": [
      {
        "name": "message",
        "type": "string",
        "description": "The message content to send to the user",
        "required": true
      }
    ],
    "vertical": []
  },
  
  "composition": {
    "steps": [
      {
        "name": "say",
        "type": "tool_call",
        "tool_name": "canvas_integration",
        "method": "me.hands.say",
        "args": {
          "message": "$input_1"
        },
        "description": "Send the message to the chat panel"
      }
    ]
  },
  
  "output": {
    "type": "status",
    "format": "ActionResult",
    "schema": {
      "success": "bool",
      "action": "string",
      "message": "string",
      "error": "string|null"
    }
  },
  
  "execution": {
    "blocking": false,
    "timeout": 5,
    "retry": false
  },
  
  "notes": [
    "Used for status emissions (thinking, executing, generating)",
    "Also used for sending final responses to user",
    "Returns ActionResult with success/failure status"
  ]
}

