{
  "metadata": {
    "description": "Block and wait for user to send a chat message via Canvas Integration Tool (me.vision.get_chat). No inputs required - this is a blocking read operation.",
    "inputs": {
      "vertical": {},
      "horizontal": {}
    },
    "outputs": {
      "type": "Literal",
      "description": "The user message dict with role, content, and timestamp"
    }
  },
  "env_spec": {
    "tools": [
      {
        "tool_name": "canvas_integration",
        "affordances": [
          {
            "affordance_name": "get_chat",
            "call_code": "result = tool.me.vision.get_chat"
          }
        ]
      },
      {
        "tool_name": "formatter_tool",
        "affordances": [
          {
            "affordance_name": "wrap",
            "call_code": "result = tool.wrap"
          }
        ]
      },
      {
        "tool_name": "composition_tool",
        "affordances": [
          {
            "affordance_name": "compose",
            "call_code": "result = tool.compose(plan=params['plan'], return_key=params.get('return_key'))"
          }
        ]
      }
    ]
  },
  "sequence_spec": {
    "steps": [
      {
        "step_index": 1,
        "affordance": "canvas_integration.get_chat",
        "params": {},
        "result_key": "get_chat_fn"
      },
      {
        "step_index": 2,
        "affordance": "formatter_tool.wrap",
        "params": {},
        "result_key": "wrap_fn"
      },
      {
        "step_index": 3,
        "affordance": "composition_tool.compose",
        "params": {
          "plan": [
            {
              "output_key": "chat_message",
              "function": {"__type__": "MetaValue", "key": "get_chat_fn"},
              "params": {}
            },
            {
              "output_key": "final_result",
              "function": {"__type__": "MetaValue", "key": "wrap_fn"},
              "params": {"__positional__": "chat_message"},
              "literal_params": {"type": "literal"}
            }
          ],
          "return_key": "final_result"
        },
        "result_key": "instruction_fn"
      }
    ]
  }
}

