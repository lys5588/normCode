{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canvas Commands Schema v2.1",
  "description": "Schema for Canvas Assistant commands using Canvas Integration Tool",
  "version": "2.1.0",
  "updated": "2026-01-26",
  
  "notes": {
    "perspectives": "Commands map to me.vision (read), me.hands (act), me.mind (control)",
    "say_vs_notify": "Use 'say' for permanent chat messages, 'notify' for temporary status"
  },
  
  "command_categories": {
    "navigation": {
      "description": "View navigation commands",
      "perspective": "me",
      "faculty": "hands",
      "commands": {
        "zoom_in": {
          "method": "zoom_in",
          "params": {"amount": {"type": "number", "default": 0.1}},
          "help": "Zoom in on the canvas"
        },
        "zoom_out": {
          "method": "zoom_out",
          "params": {"amount": {"type": "number", "default": 0.1}},
          "help": "Zoom out on the canvas"
        },
        "zoom_to": {
          "method": "zoom_to",
          "params": {"level": {"type": "number", "required": true}},
          "help": "Zoom to specific level (1.0 = 100%)"
        },
        "pan": {
          "method": "pan",
          "params": {
            "dx": {"type": "number", "required": true},
            "dy": {"type": "number", "required": true}
          },
          "help": "Pan the canvas view"
        },
        "fit_view": {
          "method": "fit_view",
          "params": {},
          "help": "Fit all nodes in the viewport"
        },
        "center_on_node": {
          "method": "center_on_node",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Center view on a specific node"
        }
      }
    },
    
    "selection": {
      "description": "Node selection commands",
      "perspective": "me",
      "faculty": "hands",
      "commands": {
        "click_node": {
          "method": "click_node",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Select/click a node"
        },
        "select_nodes": {
          "method": "select_nodes",
          "params": {"node_ids": {"type": "array", "items": "string", "required": true}},
          "help": "Select multiple nodes"
        },
        "deselect_all": {
          "method": "deselect_all",
          "params": {},
          "help": "Clear all selections"
        },
        "double_click_node": {
          "method": "double_click_node",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Double-click node (open details)"
        },
        "hover_node": {
          "method": "hover_node",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Hover over node (show tooltip)"
        }
      }
    },
    
    "structure": {
      "description": "Graph structure manipulation",
      "perspective": "me",
      "faculty": "hands",
      "commands": {
        "collapse_node": {
          "method": "collapse_node",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Collapse a node (hide descendants)"
        },
        "expand_node": {
          "method": "expand_node",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Expand a collapsed node"
        },
        "toggle_collapse": {
          "method": "toggle_collapse",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Toggle node collapse state"
        },
        "collapse_all": {
          "method": "collapse_all",
          "params": {},
          "help": "Collapse all parent nodes"
        },
        "expand_all": {
          "method": "expand_all",
          "params": {},
          "help": "Expand all collapsed nodes"
        },
        "collapse_to_level": {
          "method": "collapse_to_level",
          "params": {"level": {"type": "integer", "required": true}},
          "help": "Collapse to specific depth level"
        },
        "highlight_branch": {
          "method": "highlight_branch",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Highlight ancestors and descendants of a node"
        },
        "clear_highlight": {
          "method": "clear_highlight",
          "params": {},
          "help": "Clear branch highlighting"
        }
      }
    },
    
    "execution": {
      "description": "Plan execution control",
      "perspective": "me",
      "faculty": "mind",
      "commands": {
        "run": {
          "method": "run",
          "params": {},
          "help": "Start/resume plan execution"
        },
        "step": {
          "method": "step",
          "params": {},
          "help": "Execute one step"
        },
        "pause": {
          "method": "pause",
          "params": {},
          "help": "Pause execution"
        },
        "stop": {
          "method": "stop",
          "params": {},
          "help": "Stop execution"
        },
        "restart": {
          "method": "restart",
          "params": {},
          "help": "Restart execution from beginning"
        },
        "add_breakpoint": {
          "method": "add_breakpoint",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Add breakpoint to node"
        },
        "remove_breakpoint": {
          "method": "remove_breakpoint",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Remove breakpoint from node"
        },
        "toggle_breakpoint": {
          "method": "toggle_breakpoint",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Toggle breakpoint on node"
        },
        "clear_all_breakpoints": {
          "method": "clear_all_breakpoints",
          "params": {},
          "help": "Clear all breakpoints"
        }
      }
    },
    
    "panels": {
      "description": "Panel management",
      "perspective": "me",
      "faculty": "hands",
      "commands": {
        "open_panel": {
          "method": "open_panel",
          "params": {"panel": {"type": "string", "enum": ["chat", "agent", "log", "settings", "detail", "checkpoint", "workers", "deployment", "load"], "required": true}},
          "help": "Open a panel"
        },
        "close_panel": {
          "method": "close_panel",
          "params": {"panel": {"type": "string", "required": true}},
          "help": "Close a panel"
        },
        "toggle_panel": {
          "method": "toggle_panel",
          "params": {"panel": {"type": "string", "required": true}},
          "help": "Toggle panel visibility"
        },
        "focus_panel": {
          "method": "focus_panel",
          "params": {"panel": {"type": "string", "required": true}},
          "help": "Focus a panel"
        }
      }
    },
    
    "queries": {
      "description": "State and data queries (read-only)",
      "commands": {
        "query_project": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_project",
          "params": {},
          "help": "Get project information",
          "returns": "ProjectSnapshot with name, path, is_loaded, open_tabs"
        },
        "query_execution": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_execution",
          "params": {},
          "help": "Get execution status",
          "returns": "ExecutionSnapshot with status, current_inference, progress, node_statuses"
        },
        "query_graph": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_canvas",
          "params": {},
          "help": "Get visible graph state",
          "returns": "CanvasSnapshot with visible_nodes, visible_edges, selected, highlighted"
        },
        "query_full_view": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_full_snapshot",
          "params": {},
          "help": "Get complete UI snapshot (canvas + panels + execution)",
          "returns": "UserViewSnapshot combining all snapshots"
        },
        "query_node": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_node_details",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Get details of a specific node",
          "returns": "NodeDetails with label, type, status, value, connections"
        },
        "query_value": {
          "perspective": "me",
          "faculty": "mind",
          "method": "get_concept_value",
          "params": {"concept_name": {"type": "string", "required": true}},
          "help": "Get computed value of a concept",
          "returns": "The concept's value if computed, null otherwise"
        },
        "query_logs": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_logs",
          "params": {},
          "help": "Get recent log entries",
          "returns": "LogsSnapshot with entries array"
        },
        "query_panels": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_panels",
          "params": {},
          "help": "Get panel visibility state",
          "returns": "PanelsSnapshot with panel states"
        },
        "query_chat": {
          "perspective": "me",
          "faculty": "vision",
          "method": "get_chat",
          "params": {},
          "help": "Get chat panel state (non-blocking)",
          "returns": "ChatSnapshot with messages and pending_input"
        }
      }
    },
    
    "mind_queries": {
      "description": "Graph relationship queries (via Mind)",
      "perspective": "me",
      "faculty": "mind",
      "commands": {
        "get_ancestors": {
          "method": "get_node_ancestors",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Get all ancestor node IDs",
          "returns": "List of node IDs"
        },
        "get_descendants": {
          "method": "get_node_descendants",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Get all descendant node IDs",
          "returns": "List of node IDs"
        },
        "get_branch": {
          "method": "get_node_branch",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Get full branch (ancestors + self + descendants)",
          "returns": "List of node IDs"
        },
        "get_same_concept": {
          "method": "get_same_concept_nodes",
          "params": {"node_id": {"type": "string", "required": true}},
          "help": "Find all nodes representing the same concept",
          "returns": "List of node IDs"
        }
      }
    },
    
    "value_modification": {
      "description": "Value override commands (via Mind)",
      "perspective": "me",
      "faculty": "mind",
      "commands": {
        "override_value": {
          "method": "override_value",
          "params": {
            "concept_name": {"type": "string", "required": true},
            "value": {"type": "any", "required": true}
          },
          "help": "Override a concept's value (for debugging/testing)"
        },
        "clear_override": {
          "method": "clear_override",
          "params": {"concept_name": {"type": "string", "required": true}},
          "help": "Clear a value override"
        }
      }
    },
    
    "chat": {
      "description": "Conversational (no canvas action)",
      "perspective": null,
      "faculty": null,
      "commands": {
        "chat": {
          "method": null,
          "params": {},
          "help": "Conversational message - no canvas action needed"
        },
        "help": {
          "method": null,
          "params": {},
          "help": "Show help about available commands"
        },
        "greet": {
          "method": null,
          "params": {},
          "help": "Greeting or introduction"
        }
      }
    }
  },
  
  "response_methods": {
    "say": {
      "perspective": "me",
      "faculty": "hands",
      "method": "say",
      "description": "Send PERMANENT message (stays in chat history)",
      "use_for": "Final responses, important information"
    },
    "notify": {
      "perspective": "me",
      "faculty": "hands",
      "method": "notify",
      "params": {"status_type": {"type": "string", "enum": ["thinking", "executing", "generating", "info", "warning", "error", "success"]}},
      "description": "Send TEMPORARY notification (auto-dismisses, not in history)",
      "use_for": "Status updates during processing"
    },
    "status": {
      "perspective": "me",
      "faculty": "hands",
      "method": "status",
      "params": {"status_type": {"type": "string", "enum": ["thinking", "executing", "generating", "success", "error"]}},
      "description": "Convenience method for common status types with default messages"
    }
  },
  
  "command_aliases": {
    "select": "click_node",
    "click": "click_node",
    "focus": "center_on_node",
    "goto": "center_on_node",
    "show": "center_on_node",
    "start": "run",
    "execute": "run",
    "continue": "run",
    "resume": "run",
    "next": "step",
    "halt": "pause",
    "breakpoint": "toggle_breakpoint",
    "bp": "toggle_breakpoint",
    "collapse": "collapse_node",
    "expand": "expand_node",
    "highlight": "highlight_branch",
    "unhighlight": "clear_highlight",
    "status": "query_execution",
    "info": "query_node",
    "value": "query_value",
    "graph": "query_graph",
    "view": "query_full_view",
    "logs": "query_logs",
    "project": "query_project",
    "ancestors": "get_ancestors",
    "descendants": "get_descendants",
    "branch": "get_branch",
    "hi": "greet",
    "hello": "greet",
    "thanks": "chat",
    "bye": "chat"
  },
  
  "dispatch_rules": {
    "description": "How to execute commands based on faculty",
    "examples": {
      "hands_command": "result = canvas.me.hands.{method}(**params)",
      "vision_query": "result = canvas.me.vision.{method}(**params)",
      "mind_command": "result = canvas.me.mind.{method}(**params)",
      "chat_command": "No action needed, just respond conversationally"
    }
  }
}
