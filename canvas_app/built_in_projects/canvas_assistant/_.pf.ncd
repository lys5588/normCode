/: ════════════════════════════════════════════════════════════════════════════
/: Canvas Assistant v2.0 - Post-Formalized NormCode Plan
/: Chat-driven command loop with Canvas Integration Tool
/: ════════════════════════════════════════════════════════════════════════════

:<:{session result} | ?{flow_index}: 1
    | %{ref_axes}: [_none_axis]
    | %{ref_shape}: (1,)
    | %{ref_element}: dict(status: str, message_count: int, final_status: str)
    
    <= &[{}] %>([{canvas command schema}, [on-going messages], [all canvas statuses]]) | ?{flow_index}: 1.1 | ?{sequence}: grouping
        /: Bundle final session result
    
    /: ══════════════════════════════════════════════════════════════════════════
    /: GROUND CONCEPTS
    /: ══════════════════════════════════════════════════════════════════════════
    
    <- {canvas command schema} | ?{flow_index}: 1.2
        | %{ref_axes}: [_none_axis]
        | %{ref_shape}: (1,)
        | %{ref_element}: perceptual_sign
        | %{file_location}: provisions/schemas/canvas_commands.json
        <= $% %>({%{file_location}(provisions/schemas/canvas_commands.json)}) | ?{flow_index}: 1.2.1 | ?{sequence}: assigning
            /: Ground: load command schema from file
    
    <- [on-going messages] | ?{flow_index}: 1.3
        | %{ref_axes}: [message]
        | %{ref_shape}: (1,)
        | %{ref_element}: dict(role: str, content: str, timestamp: float)
        | %{is_invariant}: true
        <= $% %>([%({"__placeholder__": true})]) | ?{flow_index}: 1.3.1 | ?{sequence}: assigning
            | %{literal<$% on_going_messages>}: [{"__placeholder__": true}]
            /: Initialize with placeholder (not empty) for cross_product compatibility
    
    /: ══════════════════════════════════════════════════════════════════════════
    /: MAIN LOOP - Iterate over messages (self-seeding)
    /: ══════════════════════════════════════════════════════════════════════════
    
    <- [all canvas statuses] | ?{flow_index}: 1.4
        | %{ref_axes}: [iteration]
        | %{ref_shape}: (n_iteration,)
        | %{ref_element}: dict(message: dict, command_status: dict, response_sent: dict)
        
        <= *. %>([on-going messages]) %<({canvas status}) %:({message}) %@(1) | ?{flow_index}: 1.4.1 | ?{sequence}: looping
            | %{start_without_value_only_once}: true
            /: Self-seeding loop: iterates as long as messages are appended
            
            /: ──────────────────────────────────────────────────────────────────
            /: LOOP RETURN SPECIFIER
            /: ──────────────────────────────────────────────────────────────────
            
            <= $. %>({canvas status}) | ?{flow_index}: 1.4.1.1 | ?{sequence}: assigning
                /: Return the bundled canvas status for this iteration
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 1: Wait for user input (BLOCKING)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {current message} | ?{flow_index}: 1.4.1.2
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(role: str, content: str)
                <= ::(read user message from chat) | ?{flow_index}: 1.4.1.2.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Vision-GetChat-o_Literal
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.vision.get_chat
                    | %{blocking}: true
                    /: BLOCKS until user sends a message
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 2: Emit "thinking" status (v2.0)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {thinking status emitted} | ?{flow_index}: 1.4.1.3
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(success: bool, action: str)
                <= ::(emit thinking status to user) | ?{flow_index}: 1.4.1.3.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Hands-Say-o_Status
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.hands.say
                    | %{message}: "🔍 Understanding your request..."
                <- {current message} | ?{flow_index}: 1.4.1.3.2
                    /: Dependency: wait for message before emitting status
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 3: Summarize conversation context (v2.0)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {context summary} | ?{flow_index}: 1.4.1.4
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(key_points: list, last_actions: list, user_intent: str)
                <= ::(summarize on-going messages for context using {1}) | ?{flow_index}: 1.4.1.4.1 | ?{sequence}: imperative
                    | %{norm_input}: v_PromptLocation-h_Literal-c_GenerateThinkJson-o_Literal
                    | %{v_input_norm}: {prompt_location}
                    | %{v_input_provision}: provisions/prompts/summarize_context.md
                    | %{h_input_norm}: in-memory
                    | %{body_faculty}: llm
                    | %{o_shape}: dict(key_points: list, last_actions: list, user_intent: str)
                    /: LLM call: distill key points from conversation history
                <- [on-going messages]<:{1}> | ?{flow_index}: 1.4.1.4.2
                    | %{selector_packed}: true
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 4: Notify chat with context summary (v2.0)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {context notified} | ?{flow_index}: 1.4.1.5
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(success: bool, action: str)
                <= ::(notify chat with context summary using {1}) | ?{flow_index}: 1.4.1.5.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Hands-Say-o_Status
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.hands.say
                    | %{message_template}: "📋 Context: {context_summary.user_intent}"
                    /: Helps user understand what the assistant remembers
                <- {context summary}<:{1}> | ?{flow_index}: 1.4.1.5.2
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 5: Classify message as canvas command (with context)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {parsed command} | ?{flow_index}: 1.4.1.6
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(type: str, params: dict, confidence: float)
                <= ::(classify user message as canvas command using {1}, {2}, and {3}) | ?{flow_index}: 1.4.1.6.1 | ?{sequence}: imperative
                    | %{norm_input}: v_PromptLocation-h_Literal-c_GenerateThinkJson-o_Literal
                    | %{v_input_norm}: {prompt_location}
                    | %{v_input_provision}: provisions/prompts/classify_command.md
                    | %{h_input_norm}: in-memory
                    | %{body_faculty}: llm
                    | %{o_shape}: dict(type: str, params: dict, confidence: float)
                    /: Uses context summary for better disambiguation
                <- {current message}<:{1}> | ?{flow_index}: 1.4.1.6.2
                <- {canvas command schema}<:{2}> | ?{flow_index}: 1.4.1.6.3
                <- {context summary}<:{3}> | ?{flow_index}: 1.4.1.6.4
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 6: Emit "executing" status (v2.0)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {executing status emitted} | ?{flow_index}: 1.4.1.7
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(success: bool, action: str)
                <= ::(emit executing status to user) | ?{flow_index}: 1.4.1.7.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Hands-Say-o_Status
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.hands.say
                    | %{message}: "⚙️ Executing command..."
                <- {parsed command} | ?{flow_index}: 1.4.1.7.2
                    /: Dependency: wait for classification before emitting
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 7: Execute the parsed command on canvas
            /: ──────────────────────────────────────────────────────────────────
            
            <- {command status} | ?{flow_index}: 1.4.1.8
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(success: bool, action: str, message: str, error: str)
                <= ::(execute parsed command on canvas using {1}) | ?{flow_index}: 1.4.1.8.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Hands-ExecuteCommand-o_Status
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.hands.*
                    /: Dynamic dispatch based on parsed command type
                <- {parsed command}<:{1}> | ?{flow_index}: 1.4.1.8.2
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 8: Emit "generating" status (v2.0)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {generating status emitted} | ?{flow_index}: 1.4.1.9
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(success: bool, action: str)
                <= ::(emit generating status to user) | ?{flow_index}: 1.4.1.9.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Hands-Say-o_Status
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.hands.say
                    | %{message}: "💭 Generating response..."
                <- {command status} | ?{flow_index}: 1.4.1.9.2
                    /: Dependency: wait for execution before emitting
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 9: Generate helpful response (with context)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {response} | ?{flow_index}: 1.4.1.10
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(content: str, tone: str)
                <= ::(generate response based on {1}, {2}, and {3}) | ?{flow_index}: 1.4.1.10.1 | ?{sequence}: imperative
                    | %{norm_input}: v_PromptLocation-h_Literal-c_GenerateThinkJson-o_Literal
                    | %{v_input_norm}: {prompt_location}
                    | %{v_input_provision}: provisions/prompts/generate_response.md
                    | %{h_input_norm}: in-memory
                    | %{body_faculty}: llm
                    | %{o_shape}: dict(content: str, tone: str)
                    /: Uses context summary for coherent, contextual replies
                <- {current message}<:{1}> | ?{flow_index}: 1.4.1.10.2
                <- {command status}<:{2}> | ?{flow_index}: 1.4.1.10.3
                <- {context summary}<:{3}> | ?{flow_index}: 1.4.1.10.4
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 10: Send response to user
            /: ──────────────────────────────────────────────────────────────────
            
            <- {response sent} | ?{flow_index}: 1.4.1.11
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(success: bool, action: str)
                <= ::(send response to chat using {1}) | ?{flow_index}: 1.4.1.11.1 | ?{sequence}: imperative
                    | %{norm_input}: c_CanvasIntegration-Hands-Say-o_Status
                    | %{body_faculty}: canvas_integration
                    | %{method}: me.hands.say
                    /: Sends the generated response content
                <- {response}<:{1}> | ?{flow_index}: 1.4.1.11.2
            
            /: ──────────────────────────────────────────────────────────────────
            /: STEP 11: Bundle iteration results (with context)
            /: ──────────────────────────────────────────────────────────────────
            
            <- {canvas status} | ?{flow_index}: 1.4.1.12
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: dict(message: dict, context_summary: dict, command_status: dict, response_sent: dict)
                <= &[{}] %>([{current message}, {context summary}, {command status}, {response sent}]) | ?{flow_index}: 1.4.1.12.1 | ?{sequence}: grouping
                    /: Bundle the iteration results for collection (now includes context)
                <- {current message} | ?{flow_index}: 1.4.1.12.2
                <- {context summary} | ?{flow_index}: 1.4.1.12.3
                <- {command status} | ?{flow_index}: 1.4.1.12.4
                <- {response sent} | ?{flow_index}: 1.4.1.12.5
            
            /: ──────────────────────────────────────────────────────────────────
            /: LOOP CONTROL: Judge termination
            /: ──────────────────────────────────────────────────────────────────
            
            <- <session should end> | ?{flow_index}: 1.4.1.13
                | %{ref_axes}: [_none_axis]
                | %{ref_shape}: (1,)
                | %{ref_element}: %{truth value}
                <= ::(judge if user wants to end the session using {1} and {2})<ALL True> | ?{flow_index}: 1.4.1.13.1 | ?{sequence}: judgement
                    | %{norm_input}: v_PromptLocation-h_Literal-c_GenerateThinkJson-o_Boolean
                    | %{v_input_norm}: {prompt_location}
                    | %{v_input_provision}: provisions/prompts/judge_terminate.md
                    | %{h_input_norm}: in-memory
                    | %{body_faculty}: llm
                    | %{o_shape}: boolean
                    /: Check for quit/exit/bye/end intent
                <- {current message}<:{1}> | ?{flow_index}: 1.4.1.13.2
                <- [on-going messages]<:{2}> | ?{flow_index}: 1.4.1.13.3
                    | %{selector_packed}: true
            
            /: ──────────────────────────────────────────────────────────────────
            /: LOOP CONTROL: Conditional append (controls loop continuation)
            /: ──────────────────────────────────────────────────────────────────
            
            <- [on-going messages] | ?{flow_index}: 1.4.1.14
                | %{ref_axes}: [message]
                | %{ref_shape}: (n_message,)
                | %{ref_element}: dict(role: str, content: str, timestamp: float)
                | %{is_invariant}: true
                <= $+ %>([on-going messages]) %<({current message}) %:(message) | ?{flow_index}: 1.4.1.14.1 | ?{sequence}: assigning
                    /: Append current message IF session should NOT end
                    <= @:!(<session should end>) | ?{flow_index}: 1.4.1.14.1.1 | ?{sequence}: timing
                        /: Timing gate: execute only if <session should end> is FALSE
                    <* <session should end> | ?{flow_index}: 1.4.1.14.1.2
                <- {current message} | ?{flow_index}: 1.4.1.14.2
        
        /: ══════════════════════════════════════════════════════════════════════
        /: LOOP INPUT AND CONTEXT (siblings of loop operator)
        /: ══════════════════════════════════════════════════════════════════════
        
        <- [on-going messages] | ?{flow_index}: 1.4.2
            /: Loop input collection reference
        
        <* {message}<$([on-going messages])*> | ?{flow_index}: 1.4.3
            /: Loop context: current message extracted from [on-going messages]

