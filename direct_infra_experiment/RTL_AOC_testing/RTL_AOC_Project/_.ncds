                    <- AOC schemas records
                    <- new AOC

                <- no more canonicals to process?
                    <= judge if there are more canonicals to process
                    <- all user inputs
                    <- AOC schemas records
                
                /: Continue unless done: append next counter if not terminated
                <- counters
                    <= append next counter to counters
                        <= if session should NOT end
                        <* no more canonicals to process?
                    <- counters
                    <- next counter
                        <= compute next counter as current counter plus one
                        <- current counter
            
            <- counters
            <* current counter from counters
        
        <- all AOC schema
            <= clean up and consolidate all AOC schemas into one
            <- AOC schemas extracted so far
    
    /: Validate the generated AOC
    <- AOC is valid?
        <= judge if all AOC rules are valid
        <- AOC definitions
    
    /: ============================================================
    /: PHASE 2: Verification Against RTL Trace
    /: ============================================================
    
    /: Load and prepare trace data
    <- RTL simulation trace
        <= load trace from simulation output
        <- trace file
    
    <- trace per cycle
        <= split trace into discrete cycles
        <- RTL simulation trace
    
    /: The verification loop
    <- verification per cycle
        <= for each cycle trace in trace per cycle
        
            <= return the verification result for this iteration
                <= only if AOC is valid
                <* AOC is valid?
            
            <- active rules
                <= update active rules based on current cycle
                <- current cycle trace
                <- previous active rules
                <- AOC definitions
            
            <- verification
                <= verify trace against active rules for this cycle
                <- current cycle trace
                <- active rules
        
        <- trace per cycle
        <* current cycle trace from trace per cycle
        <* previous active rules carried from active rules

    <- all information about the testing
        <= collect (into a single annotation dict) all information about AOC definitions, verification per cycle, RTL simulation trace, all user inputs, 
        <- AOC definitions
