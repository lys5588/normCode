
/: The Root Goal: A Valid schema of AOC Rules
:<: ({all AOC Schema})
    <= $. ({all AOC Schema}) /: returns this AOC schema as output

    /: Input 1: The Raw ISA Specification
    <* {ISA Spec Text}
        <= ::({Load File})
        <* {File Path} %:{location_string}("specs/isa_v1.md")

    /: Input 2: Micro-Architecture Constraints (Optional)
    <* {MA Spec Text}
        <= ::({Load File})
        <* {File Path} %:{location_string}("specs/uarch_v2.md")

    /: Step 1: Decomposition (Split text into atomic intent blocks)
    <* {Intent Blocks}
        <= :>:(user clarification of the inputted specs)
        <- {ISA Spec Text}
        <- {MA Spec Text}

    <* [All user inputs: {ISA}, {MA}, {Intent Blocks}]
        <= &[{}] %>[{ISA}, {MA}, {Intent Blocks}]
        <- {ISA}
        <- {MA}
        <- {Intent Blocks}

    <* {counters}
        <* $% ({%(1)}) /: initate counters with only a 1.

    /： use continuation logic to initiate a loop of termination (unless)
    <* {AOC schemas per connonical}
        <= *. %>({counter}) %*({Current counter})

            <= $.({the new AOC})

            <* {all AOC schemas per connonicals up to now}
                <= &[#] {AOC schemas per connonicals}
                <- {AOC schemas per connonicals}

            <- {the new AOC}
                <= ::(extract a new action-obligation connonicals) /: we will provide a prompt with llm action for this imperative 
                <- [All user inputs: {ISA}, {MA}, {Intent Blocks}] /: with derelations interpretations added
                <- {all AOC schemas per connonicals up to now}

            <* <there are no more connonicals to process> /: termination conditions
                <= ::(judge if there are more connonicals to process)<ALL True> /: Judgement of terminations, will be driven by prompts
                <- [All user inputs: {ISA}, {MA}, {Intent Blocks}] /: with derelations interpretations added

            /:  continuation unless termination (unless)
            <* {counters}
                <= $+ ({%(n)})
                    <= @:! (<there are no more connonicals to process>)
                    <- <there are no more connonicals to process> /: no passing of data, here to make execution flow correct. Judge after the proposition has value.
                    <* <there are no more connonicals to process>
                <- {counters}
                <- {next counter}
                    <= :: (next counter = current counter + 1)
                    <= {current counter}

        <- {counters} /: the collection to loop over
        <* {current counter}<$({counters})*>

    <- {all AOC Schema}
        <= ::(clean-up and collect the AOC schemas into one) /: final proof-writing revision with llm help
        <- {all AOC schemas per connonicals up to now}

