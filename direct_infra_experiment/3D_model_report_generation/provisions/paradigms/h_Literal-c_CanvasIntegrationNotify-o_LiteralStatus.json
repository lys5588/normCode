{
  "metadata": {
    "description": "Send a TEMPORARY notification/status to the user via Canvas Integration Tool (me.hands.notify). Used for ephemeral status updates like 'thinking...', 'executing...'. Does NOT persist in chat history.",
    "inputs": {
      "vertical": {},
      "horizontal": {
        "message": "The notification content (string or dict with 'content' field)"
      }
    },
    "outputs": {
      "type": "LiteralStatus",
      "description": "ActionResult dict with success, action, message fields (literal, no perception sign)"
    }
  },
  "env_spec": {
    "tools": [
      {
        "tool_name": "canvas_integration",
        "affordances": [
          {
            "affordance_name": "notify",
            "call_code": "result = tool.me.hands.notify"
          }
        ]
      },
      {
        "tool_name": "formatter_tool",
        "affordances": [
          {
            "affordance_name": "get",
            "call_code": "result = tool.get"
          },
          {
            "affordance_name": "wrap",
            "call_code": "result = tool.wrap"
          }
        ]
      },
      {
        "tool_name": "composition_tool",
        "affordances": [
          {
            "affordance_name": "compose",
            "call_code": "result = tool.compose(plan=params['plan'], return_key=params.get('return_key'))"
          }
        ]
      }
    ]
  },
  "sequence_spec": {
    "steps": [
      {
        "step_index": 1,
        "affordance": "canvas_integration.notify",
        "params": {},
        "result_key": "notify_fn"
      },
      {
        "step_index": 2,
        "affordance": "formatter_tool.get",
        "params": {},
        "result_key": "get_fn"
      },
      {
        "step_index": 3,
        "affordance": "formatter_tool.wrap",
        "params": {},
        "result_key": "wrap_fn"
      },
      {
        "step_index": 4,
        "affordance": "composition_tool.compose",
        "params": {
          "plan": [
            {
              "output_key": "message_content",
              "function": {"__type__": "MetaValue", "key": "get_fn"},
              "params": {"dictionary": "__initial_input__"},
              "literal_params": {"key": "input_1"}
            },
            {
              "output_key": "notify_result",
              "function": {"__type__": "MetaValue", "key": "notify_fn"},
              "params": {"message": "message_content"}
            },
            {
              "output_key": "final_result",
              "function": {"__type__": "MetaValue", "key": "wrap_fn"},
              "params": {"__positional__": "notify_result"},
              "literal_params": {"type": "literal"}
            }
          ],
          "return_key": "final_result"
        },
        "result_key": "instruction_fn"
      }
    ]
  }
}

