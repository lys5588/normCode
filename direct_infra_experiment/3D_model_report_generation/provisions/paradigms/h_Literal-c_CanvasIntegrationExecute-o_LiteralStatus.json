{
  "metadata": {
    "description": "Execute a parsed canvas command via Canvas Integration Tool. Dynamically dispatches to me.hands.*, me.mind.*, or me.vision.* based on command type.",
    "inputs": {
      "vertical": {},
      "horizontal": {
        "parsed_command": "Dict with type, params, confidence fields"
      }
    },
    "outputs": {
      "type": "LiteralStatus",
      "description": "ActionResult dict with success, action, message, error fields (literal, no perception sign)"
    }
  },
  "env_spec": {
    "tools": [
      {
        "tool_name": "canvas_integration",
        "affordances": [
          {
            "affordance_name": "execute_command",
            "call_code": "result = tool.me.hands.execute_command"
          }
        ]
      },
      {
        "tool_name": "formatter_tool",
        "affordances": [
          {
            "affordance_name": "get",
            "call_code": "result = tool.get"
          },
          {
            "affordance_name": "wrap",
            "call_code": "result = tool.wrap"
          }
        ]
      },
      {
        "tool_name": "composition_tool",
        "affordances": [
          {
            "affordance_name": "compose",
            "call_code": "result = tool.compose(plan=params['plan'], return_key=params.get('return_key'))"
          }
        ]
      }
    ]
  },
  "sequence_spec": {
    "steps": [
      {
        "step_index": 1,
        "affordance": "canvas_integration.execute_command",
        "params": {},
        "result_key": "execute_fn"
      },
      {
        "step_index": 2,
        "affordance": "formatter_tool.get",
        "params": {},
        "result_key": "get_fn"
      },
      {
        "step_index": 3,
        "affordance": "formatter_tool.wrap",
        "params": {},
        "result_key": "wrap_fn"
      },
      {
        "step_index": 4,
        "affordance": "composition_tool.compose",
        "params": {
          "plan": [
            {
              "output_key": "command_dict",
              "function": {"__type__": "MetaValue", "key": "get_fn"},
              "params": {"dictionary": "__initial_input__"},
              "literal_params": {"key": "input_1"}
            },
            {
              "output_key": "execute_result",
              "function": {"__type__": "MetaValue", "key": "execute_fn"},
              "params": {"command": "command_dict"}
            },
            {
              "output_key": "final_result",
              "function": {"__type__": "MetaValue", "key": "wrap_fn"},
              "params": {"__positional__": "execute_result"},
              "literal_params": {"type": "literal"}
            }
          ],
          "return_key": "final_result"
        },
        "result_key": "instruction_fn"
      }
    ]
  }
}

